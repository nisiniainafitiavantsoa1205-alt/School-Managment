<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.prisma.controller.BulletinController"
    spacing="15"
    style="-fx-background-color: transparent;"
    VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- BARRE DE FILTRES ET DÉCLENCHEUR DE CALCUL -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="kpi-card">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>
        <children>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Classe" styleClass="form-label"/>
                <ComboBox fx:id="cmbClasse" styleClass="form-control" maxWidth="Infinity" promptText="Choisir une classe" onAction="#handleSelectionChange"/>
            </VBox>

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Trimestre" styleClass="form-label"/>
                <ComboBox fx:id="cmbPeriode" styleClass="form-control" maxWidth="Infinity" promptText="Choisir un trimestre" onAction="#handleSelectionChange"/>
            </VBox>

            <VBox spacing="4" alignment="BOTTOM_LEFT">
                <Button text="⟳  Recalculer les Bulletins de Classe" styleClass="btn-primary" onAction="#handleCalculer"
                        style="-fx-font-weight: bold; -fx-padding: 8px 20px;"/>
            </VBox>
        </children>
    </HBox>

    <!-- RÉSUMÉ DE LA CLASSE (KPI CARDS) -->
    <HBox spacing="15" alignment="CENTER">
        <children>
            <VBox styleClass="kpi-card" alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS" prefHeight="80">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <children>
                    <Label fx:id="lblNbEleves" text="—" style="-fx-text-fill: #FFD700; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <Label text="Élèves évalués" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px;"/>
                </children>
            </VBox>
            <VBox styleClass="kpi-card" alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS" prefHeight="80">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <children>
                    <Label fx:id="lblMoyenneClasse" text="—" style="-fx-text-fill: #4FE0B6; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                    <Label text="Moyenne de classe" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px;"/>
                </children>
            </VBox>
            <VBox styleClass="kpi-card" alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS" prefHeight="80">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <children>
                    <Label fx:id="lblMeilleurEleve" text="—" style="-fx-text-fill: #4FE0B6; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="1er de classe" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px;"/>
                </children>
            </VBox>
            <VBox styleClass="kpi-card" alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS" prefHeight="80">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                <children>
                    <Label fx:id="lblStatut" text="Non calculé" style="-fx-text-fill: #F39C12; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label text="Statut du calcul" style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12px;"/>
                </children>
            </VBox>
        </children>
    </HBox>

    <!-- TABLEAU DES RÉSULTATS PAR ÉLÈVE -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="kpi-card">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <children>
                    <Label text="Tableau de classement de la classe" style="-fx-text-fill: #FFD700; -fx-font-size: 16px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtSearchEleve" promptText="Filtrer élève (nom, matricule)..." styleClass="form-control" prefWidth="240"/>
                    <Button fx:id="btnExporterPDF" text="🖨  Générer les bulletins PDF" styleClass="btn-primary"
                            style="-fx-font-weight: bold; -fx-padding: 8px 20px;" onAction="#handleGeneratePDF"/>
                </children>
            </HBox>

            <TableView fx:id="tblBulletins" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRang" text="Rang" prefWidth="70" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colMatricule" text="Matricule" prefWidth="110"/>
                    <TableColumn fx:id="colNomPrenom" text="Nom &amp; Prénoms" prefWidth="220"/>
                    <TableColumn fx:id="colParcours" text="Parcours" prefWidth="95" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colTotalPts" text="Total Pts" prefWidth="85" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colTotalCoef" text="Total Coef." prefWidth="85" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colMoyenne" text="Moy. Générale" prefWidth="115" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colMention" text="Mention" prefWidth="110" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colAppreciation" text="Appréciation du Conseil" prefWidth="260"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <children>
                    <Label text="Double-cliquez sur une ligne pour saisir l'appréciation générale du professeur principal." 
                           style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11px;"/>
                </children>
            </HBox>
        </children>
    </VBox>
</VBox>
